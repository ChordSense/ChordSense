# Copy to /etc/chordsense/api.env and fill in real values before enabling.
CHORDSENSE_API_HOST=0.0.0.0
CHORDSENSE_API_PORT=5051
CHORDSENSE_API_THREADS=8
CHORDSENSE_MAX_UPLOAD_MB=95

# Set the Pi hostname to chordsense and enable Avahi/mDNS on the target LAN.
# Exact comma-separated browser origins, without paths or trailing slashes.
CHORDSENSE_ALLOWED_ORIGINS=https://your-app.vercel.app
# Public website address shown in the native Pair uploads dialog.
CHORDSENSE_COMPANION_URL=https://your-app.vercel.app
# Pairing generates one-use codes and per-tab tokens; no shared device secret.
# Trusted-network HTTP prototype: codes, tokens and audio are not encrypted.

CHORDSENSE_IOD_SOCKET=/run/chordsense/iod.sock

# Full URL for a separate analysis worker, including /analyze.
# Leave unset to preserve local analysis/Hailo recording behavior.
# CHORDSENSE_ANALYSIS_URL=https://your-analysis-worker.example/analyze
# CHORDSENSE_ANALYSIS_TOKEN=replace-with-worker-token
# CHORDSENSE_ANALYSIS_TIMEOUT=960

OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
