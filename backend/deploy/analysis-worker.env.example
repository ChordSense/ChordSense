# Only on a separate compute host. Keep these out of frontend/Vercel variables.
CHORDSENSE_WORKER_TOKEN=replace-with-a-long-random-worker-token
CHORDSENSE_WORKER_HOST=127.0.0.1
CHORDSENSE_WORKER_PORT=5052
CHORDSENSE_WORKER_MAX_UPLOAD_MB=300
CHORDSENSE_MODEL_TIMEOUT=900
# Optional when the model checkout/venv is outside backend/models:
# CHORDSENSE_MODEL_REPO=/srv/ChordSense/backend/models/chord-cnn-lstm-model
# CHORDSENSE_MODEL_PYTHON=/srv/ChordSense/backend/models/chord-cnn-lstm-model/venv/bin/python
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
