# Shared environment for chordsense-iod.
#
# Read by the systemd unit (EnvironmentFile=) and safe to source into a shell
# before starting the backend so both sides agree on the socket path:
#
#     set -a; . iod/deploy/chordsense-iod.env; set +a
#     ( cd backend && .venv/bin/python app.py )
#
# See iod/src/main.rs for how each is resolved when unset.

# Control socket. The unit's RuntimeDirectory= owns /run/chordsense.
CHORDSENSE_IOD_SOCKET=/run/chordsense/iod.sock

# Where captured WAVs are written. Must be readable by the backend (same user).
# Kept inside the repo's gitignored runtime/ dir by default.
CHORDSENSE_CAPTURES_DIR=/home/chordsense/workspace/ChordSense/runtime/captures

# spidev node for the MCP3201.
CHORDSENSE_SPI_DEVICE=/dev/spidev0.0

# Substring (case-insensitive) of the ALSA output device for the PCM5102A DAC,
# once an I2S dtoverlay is enabled and `aplay -l` shows it. Unset -> system
# default output (HDMI on the dev Pi), with a warning.
#CHORDSENSE_I2S_DEVICE_MATCH=pcm5102
